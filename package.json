{
  "name": "agent-webmcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "agent-webmcp": "./src/main.ts"
  },
  "scripts": {
    "start": "bun ./src/main.ts",
    "gen": "bun ./scripts/gen-versions.ts",
    "check:gen": "bun ./scripts/gen-versions.ts --check",
    "compile": "bun ./scripts/compile.ts",
    "test": "bun test src",
    "review": "bun ./scripts/review.ts",
    "gate": "bun ./scripts/gate.ts",
    "setup": "bun ./scripts/setup.ts",
    "review:eval": "bun ./scripts/review-eval.ts",
    "eval:transport": "bun ./scripts/eval-transport.ts",
    "eval:sessions": "bun ./scripts/eval-sessions.ts",
    "eval:mcp": "bun ./scripts/eval-mcp.ts",
    "eval:cloudflare": "bun ./scripts/eval-cloudflare.ts",
    "eval:xpage": "bun ./scripts/eval-xpage.ts",
    "eval:real": "bun ./scripts/eval-real.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
